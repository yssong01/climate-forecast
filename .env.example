# 기상청 기상자료개방포털 인증키
# https://data.kma.go.kr 에서 발급받은 서비스 키 (URL 인코딩된 키 사용)
KMA_API_KEY=your_api_key_here

# ASOS 관측소 번호 (108=서울, 159=부산, 143=대구, 156=광주, 133=대전, 184=제주)
# 전체 목록: https://apihub.kma.go.kr → 관측소 정보
KMA_STN=108

# Streamlit Community Cloud Secrets (배포 시 동일 키 입력)
# https://share.streamlit.io → App settings → Secrets
